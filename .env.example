# BizHawk MCP — configuration
#
# Copy this file to `.env` and adjust for your machine. All shell scripts
# source it (scripts/load-env.sh) and the MSBuild build reads BIZHAWK_INSTALL
# from the environment (Directory.Build.props). Values here are examples —
# everything is optional; defaults are shown as comments.

# ── BizHawk install (needed to BUILD; deploy copies the DLL into it) ─────────
# Path to a BizHawk "output tree": EmuHawk.exe at the root, assemblies in dll/.
# Pick the form that matches where you BUILD:
#   Windows native build → Windows path:
#       BIZHAWK_INSTALL=F:\path\to\BizHawk-dev-windows
#   WSL/Linux building a Windows BizHawk install (EmuHawk runs on Windows):
#       BIZHAWK_INSTALL=/mnt/f/path/to/BizHawk-dev-windows
#   Linux (Mono EmuHawk) → Linux path:
#       BIZHAWK_INSTALL=/opt/BizHawk-linux
# Leave empty to fall back to the legacy auto-detected paths in
# Directory.Build.props (or pass -p:BizHawkInstallDir=<path> to dotnet).
BIZHAWK_INSTALL=

# ── MCP server bind address/port ─────────────────────────────────────────────
# Read at RUNTIME by the plugin (McpHttpServer), from the process environment
# of the EmuHawk that hosts it. If you run EmuHawk from a shell that sourced
# this .env they apply automatically; otherwise export them before launching
# EmuHawk, or leave the defaults.
BIZHAWK_MCP_HOST=127.0.0.1
BIZHAWK_MCP_PORT=8767

# ── .NET SDK location (optional) ─────────────────────────────────────────────
# WSL/Linux users who installed the SDK with dotnet-install.sh (default
# ~/.dotnet): the scripts auto-detect that path; set DOTNET_ROOT to override.
# DOTNET_ROOT=/home/you/.dotnet
