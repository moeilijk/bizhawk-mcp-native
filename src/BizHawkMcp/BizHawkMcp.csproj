<Project Sdk="Microsoft.NET.Sdk">

  <!--
    External tool (net48, like the repo's own ExternalToolProjects):
    loads inside EmuHawk's process on both Windows (.NET 8 compat) and
    Linux (Mono). net48 is the only TFM that runs on both runtimes.

    Trade-off: the official MCP SDKs require .NET 8+, so the Streamable
    HTTP endpoint is implemented by hand in src/BizHawkMcp/Mcp (HttpListener).
  -->

  <PropertyGroup>
    <!-- The NuGet System.Memory facade (4.0.1.2) vs BizHawk's DLLs (bound to
         4.0.5.0): unified at runtime by the host (EmuHawk ships its own), so
         the build-time MSB3277 conflict is expected and harmless. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>BizHawkMcp</AssemblyName>
    <RootNamespace>BizHawkMcp</RootNamespace>
    <!-- single source of truth for the version advertised in initialize /
         server/discover serverInfo (JsonRpc.ServerVersion reads it) -->
    <Version>0.3.1</Version>
    <OutputType>Library</OutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- builds on Linux/macOS: pulls the .NET Framework reference assemblies from NuGet -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- match the System.Text.Json version BizHawk ships in its dll/ folder (9.0.x) to avoid runtime conflicts -->
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BizHawkMcp.Tests" />
  </ItemGroup>

  <!-- Reference the installed BizHawk assemblies directly (same pattern as the repo's ExtToolCommon.props/NET48ExternalToolForm.targets). -->
  <ItemGroup>
    <Reference Include="BizHawk.Client.Common">
      <HintPath>$(BizHawkInstallDir)/dll/BizHawk.Client.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BizHawk.Common">
      <HintPath>$(BizHawkInstallDir)/dll/BizHawk.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BizHawk.Emulation.Common">
      <HintPath>$(BizHawkInstallDir)/dll/BizHawk.Emulation.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="NLua">
      <HintPath>$(BizHawkInstallDir)/dll/NLua.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Drop the built tool (and its non-BizHawk deps) into the install's ExternalTools folder;
       EmuHawk's ExternalToolManager watches it with a FileSystemWatcher.
       Windows locks loaded DLLs: if EmuHawk has the tool form open, the copy fails (MSB3021,
       non-fatal thanks to ContinueOnError) — close it (or EmuHawk) and rebuild. -->
  <ItemGroup>
    <_ToolOutput Include="$(TargetDir)*.dll" />
  </ItemGroup>
  <Target Name="CopyToExternalTools" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Copy SourceFiles="@(_ToolOutput)" DestinationFolder="$(BizHawkInstallDir)/ExternalTools" ContinueOnError="true" />
  </Target>

  <!-- This project compiles against an installed BizHawk output tree; fail with
       instructions instead of a cryptic reference error. (Only the product
       project needs it — the tests stub the API and skip this.) -->
  <Target Name="RequireBizHawkInstall" BeforeTargets="ResolveReferences">
    <Error Condition="'$(BizHawkInstallDir)' == ''"
           Text="BizHawk install dir not found. Set BIZHAWK_INSTALL in .env (copy .env.example, see README 'Setup'), pass -p:BizHawkInstallDir=&lt;path&gt;, or create a symlink/install at one of the auto-detected paths." />
  </Target>

</Project>
